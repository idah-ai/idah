# Development settings for the iam service, read by the service itself at boot.
# Test runs read .env.test instead.
#
# Why here and not in config/development/: variables Compose passes to a
# container override this file, so anything set there would also apply to test
# runs inside a dev container. That is how a test run once reset a development
# database. config/development/.env only says how containers reach PostgreSQL
# and Redis; every application setting belongs here.

# Host, port and credentials come from config/development/.env.
POSTGRES_DB_NAME=idah_iam_development
DATABASE_URI=postgres://$POSTGRES_CREDENTIALS@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB_NAME

IDAH_URL=https://idah.localhost:8443
# Service-to-service calls: through nginx on the Docker network, as deployed.
IDAH_INTERNAL_URL=http://nginx:8081
SERVICE_DOMAIN=idah.localhost

# iam signs service tokens, so it holds the private key.
SERVICE_JWT_KEY=file:./config/keys/private.dev.pem

IDAH_SERVICE_ACCOUNT=iam@services.idah.ai
IDAH_SERVICE_PASSWORD=password

