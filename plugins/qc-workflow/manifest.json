{
  "type": "idah-plugin",
  "name": "qc-workflow",
  "version": "1.0.0",

  "title": "QC Annotation Workflow",
  "description": "Annotation workflow that sends annotations to an external QC application and resumes when the app calls back.",

  "repository": {
    "type": "git",
    "url": ""
  },

  "workflows": [
    {
      "name": "qc-annotation-workflow",
      "label": "QC Annotation Workflow",
      "description": "Annotate → External QC → Review → Done"
    }
  ],

  "entryPoints": {
    "datasetConfig": "config/dataset.json",
    "backend": {
      "module": "QcWorkflow",
      "path": "backends"
    }
  }
}