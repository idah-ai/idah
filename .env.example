# Variables docker compose reads from a root .env file (gitignored).
# Copy to .env and uncomment what you need.

# Development databases. Postgres and Redis run as containers by default.
# To use the ones on your machine instead:
# IDAH_POSTGRES_HOST=host.docker.internal
# IDAH_POSTGRES_CONTAINER=0
# IDAH_REDIS_HOST=host.docker.internal
# IDAH_REDIS_CONTAINER=0

# Development database credentials (default postgres / postgres), used by the
# services and by the postgres container when it first creates its data:
# IDAH_POSTGRES_USER=postgres
# IDAH_POSTGRES_PASSWORD=postgres

# Host ports for the database containers, if 5432 or 6379 are already taken:
# IDAH_POSTGRES_PORT=5432
# IDAH_REDIS_PORT=6379

# Sentry DSNs for the development stack (optional)
# SENTRY_DSN_IAM=
# SENTRY_DSN_MEDIA=
# SENTRY_DSN_DATASET=
# SENTRY_DSN_SETTING=
# SENTRY_DSN_AUDIT=
# SENTRY_DSN_SYNC=
# SENTRY_DSN_NOTIFICATION=
# SENTRY_DSN_FRONTEND=

# Compose passes SENTRY_DSN_FRONTEND to the frontend as PUBLIC_SENTRY_DSN.
