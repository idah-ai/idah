#!/usr/bin/env bash
# Tag an IDAH release (RELEASE.md §4).
#
#   bin/tag-release 0.2.0-rc.1            a candidate, on the latest main from GitHub
#   bin/tag-release 0.2.0                 the stable release, on its latest candidate's commit
#   bin/tag-release --dry-run 0.2.0       show what would be tagged, and create nothing
#   bin/tag-release --previous-stable 0.2.0-rc.1
#                                         print the stable tag the release compares against
#
# The tag is annotated: it records who tagged and when, and lists the pull
# requests merged since the previous stable version, a message you can edit
# before the tag is created. Pushing it starts the release workflow, so the
# script asks first. Tags are never moved or replaced, and only a commit CI
# has passed on main is tagged (checked with the GitHub CLI, gh).

set -euo pipefail

REMOTE="${IDAH_RELEASE_REMOTE:-origin}"

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-1}"
}

die() {
  echo "tag-release: $*" >&2
  exit 1
}

# The version tags on the remote, one per line.
remote_version_tags() {
  git ls-remote --tags --refs "$REMOTE" 'v*' | sed 's|.*refs/tags/||'
}

# The highest stable tag below VERSION's own number, read from tags on stdin.
# Candidates are skipped, so 0.2.0-rc.1 and 0.2.0 both compare against the
# last 0.1.x. Versions compare as numbers: 0.10.0 comes after 0.2.0. Prints
# nothing before the first stable release.
previous_stable() {
  local current="v${1%%-*}"

  { grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' || true; } \
    | { grep -vxF "$current" || true; } \
    | { cat; echo "$current"; } \
    | sort -V \
    | awk -v current="$current" '$0 == current { print previous; exit } { previous = $0 }'
}

# The latest candidate for VERSION (e.g. v0.2.0-rc.3), read from tags on stdin.
latest_candidate() {
  local escaped="${1//./\\.}"

  { grep -E "^v${escaped}-rc\.[0-9]+$" || true; } | sort -V | tail -n 1
}

# The checks a commit must have passed on main before it is tagged: the gate
# job of each CI workflow. They run on every merge to main and always report,
# even when the tests behind them were skipped. Other checks on the commit,
# such as GitHub's own Dependabot run, do not count.
REQUIRED_CHECKS=("App CI passed" "Common CI passed" "Plugins CI passed" "Scripts CI passed")

# What stands between a commit and its tag, one line each, read from its check
# runs on stdin ("name<TAB>status<TAB>conclusion<TAB>started_at"). Prints
# nothing when every required check has passed. A check can have run more than
# once on a commit (a re-run, or a run cancelled by a second one), so only the
# latest counts: a cancelled run's gate reports failure, and an old failure
# must not outweigh the run that replaced it, nor an old success a new failure.
ci_problems() {
  local latest name status conclusion
  # Newest first. ISO times sort as text; a queued run has no start time yet
  # ("null"), which sorts above them, so it counts as the latest.
  latest="$(sort -t "$(printf '\t')" -k4,4r)"

  for name in "${REQUIRED_CHECKS[@]}"; do
    status="$(awk -F'\t' -v n="$name" '$1 == n { print $2; exit }' <<<"$latest")"
    conclusion="$(awk -F'\t' -v n="$name" '$1 == n { print $3; exit }' <<<"$latest")"

    if [ -z "$status" ]; then
      echo "$name has not run on this commit"
    elif [ "$status" != completed ]; then
      echo "$name is still running"
    elif [ "$conclusion" != success ]; then
      echo "$name: $conclusion"
    fi
  done
}

# The GitHub owner/repo of the remote, for the link to the workflow run.
repository_slug() {
  git remote get-url "$REMOTE" | sed -E 's#^.*github\.com[:/]##; s#\.git$##'
}

main() {
  local dry_run=false

  case "${1:-}" in
    -h | --help) usage 0 ;;
    --previous-stable)
      [ $# -eq 2 ] || usage
      remote_version_tags | previous_stable "${2#v}"
      return
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
  esac

  [ $# -eq 1 ] || usage

  local version="${1#v}"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$ ]] \
    || die "'$1' is not a version such as 0.2.0 or 0.2.0-rc.1"
  local tag="v$version"

  # The remote is the source of truth for main and for tags.
  git fetch --quiet "$REMOTE" main
  git fetch --quiet --tags --force "$REMOTE"

  local tags
  tags="$(remote_version_tags)"

  if grep -qxF "$tag" <<<"$tags"; then
    die "$tag already exists on $REMOTE. Tags are never moved: release the next version instead."
  fi
  if git rev-parse --quiet --verify "refs/tags/$tag" >/dev/null; then
    die "$tag exists locally but not on $REMOTE. If it was never pushed, remove it with: git tag -d $tag"
  fi

  local commit source
  if [[ "$version" == *-rc.* ]]; then
    commit="$(git rev-parse "$REMOTE/main^{commit}")"
    source="the latest $REMOTE/main"

    if git rev-parse --quiet --verify main >/dev/null \
      && [ -n "$(git rev-list "$REMOTE/main..main")" ]; then
      echo "Note: your local main has commits that are not on $REMOTE/main; they are not part of $tag."
    fi
  else
    local candidate
    candidate="$(latest_candidate "$version" <<<"$tags")"
    [ -n "$candidate" ] \
      || die "no candidate for $tag yet. Tag and verify $tag-rc.1 first (RELEASE.md §4.2-4.3)."
    commit="$(git rev-parse "$candidate^{commit}")"
    source="the commit of $candidate"
  fi

  # Only a commit CI has passed on main. A pull request is tested against main
  # as it was then, so this is the one test of the code as it will ship.
  command -v gh >/dev/null \
    || die "the GitHub CLI (gh) is needed to check CI on the commit. Install it and run: gh auth login"
  local slug runs problems
  slug="$(repository_slug)"
  runs="$(gh api "repos/$slug/commits/$commit/check-runs?per_page=100" \
    --jq '.check_runs[] | "\(.name)\t\(.status)\t\(.conclusion)\t\(.started_at)"')" \
    || die "could not read the checks of $commit from GitHub. Is gh logged in? Try: gh auth status"
  problems="$(ci_problems <<<"$runs")"

  if [ -n "$problems" ] && ! $dry_run; then
    die "CI has not passed on this commit, so it cannot be tagged:
$(sed 's/^/  /' <<<"$problems")
Wait for CI to finish, or fix main and tag the next merge.
Checks: https://github.com/$slug/commit/$commit"
  fi

  local previous
  previous="$(previous_stable "$version" <<<"$tags")"

  local message
  message="$tag"$'\n\n'"$(git log --reverse --format='- %s' "${previous:+$previous..}$commit")"

  echo "Tag:       $tag"
  echo "Commit:    $(git log -1 --format='%h %s' "$commit") ($source)"
  echo "Changes:   since ${previous:-the first commit}"
  if [ -z "$problems" ]; then
    echo "CI:        passed on main"
  else
    echo "CI:        not passed, so a real run would stop here:"
    sed 's/^/             /' <<<"$problems"
  fi
  echo

  if $dry_run; then
    echo "$message"
    echo
    echo "Dry run: nothing was created."
    return
  fi

  local message_file
  message_file="$(mktemp)"
  # Expanded now: the variable is local and gone by the time the script exits.
  # shellcheck disable=SC2064
  trap "rm -f '$message_file'" EXIT
  printf '%s\n' "$message" >"$message_file"

  # Opens your editor with the message. Quitting with an empty message cancels.
  git tag --annotate --edit --file "$message_file" "$tag" "$commit"

  echo
  git show --no-patch "$tag"
  echo

  local answer
  read -r -p "Push $tag to $REMOTE? This starts the release workflow. [y/N] " answer
  case "$answer" in
    y | Y | yes) ;;
    *)
      echo "Not pushed. Push it later with: git push $REMOTE refs/tags/$tag"
      echo "Or remove it with: git tag -d $tag"
      return
      ;;
  esac

  git push "$REMOTE" "refs/tags/$tag"
  echo
  echo "Release workflow: https://github.com/$(repository_slug)/actions/workflows/cd-app.yml"
}

# Run only when executed, so the functions can be sourced by the tests.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
