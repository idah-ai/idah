# Settings for an IDAH install. Copy to .env beside idah.yml.
#
# install.sh writes this file for you and generates every secret. Edit it by
# hand only if you are installing without that script, or changing a setting
# later. After any change: docker compose -f idah.yml up -d

# --- Required -------------------------------------------------------------

# The release to run. Every service uses this tag; upgrade by changing it.
IDAH_VERSION=

# The public URL users open in a browser, scheme included, no trailing slash.
IDAH_URL=https://idah.example.com

# --- Secrets, generated by install.sh -------------------------------------

# PostgreSQL. Changing these after the first start does not change the
# database; the volume keeps the credentials it was created with.
POSTGRES_USER=idah
POSTGRES_PASSWORD=

# Shared by the seven internal service accounts.
IDAH_SERVICE_PASSWORD=

# --- Email ----------------------------------------------------------------
# The notification service does not start without these.

MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# --- Optional -------------------------------------------------------------

# The port nginx listens on. Put your own TLS terminator in front of it.
# IDAH_HTTP_PORT=8080

# info is the default. debug is noisy but useful when reporting a problem.
# LOG_LEVEL=info

# Returns error details in API responses. Keep off outside debugging.
# LOG_SHOW_ERROR_DETAILS=false

# --- Optional: S3 instead of local file storage ---------------------------
# Uploaded files go to the media_files and sync_files volumes by default.
# Setting an adapter to s3 makes all five of its settings required; a missing
# one stops that service at boot with the variable named.

# MEDIAS_FILES_ADAPTER=s3
# MEDIAS_FILES_BUCKET=
# MEDIAS_FILES_REGION=
# MEDIAS_FILES_ENDPOINT=
# MEDIAS_FILES_ACCESS_KEY_ID=
# MEDIAS_FILES_SECRET_ACCESS_KEY=

# SYNC_FILES_ADAPTER=s3
# SYNC_FILES_BUCKET=
# SYNC_FILES_REGION=
# SYNC_FILES_ENDPOINT=
# SYNC_FILES_ACCESS_KEY_ID=
# SYNC_FILES_SECRET_ACCESS_KEY=

# --- Optional: error reporting --------------------------------------------
# Per-service Sentry DSNs. Empty disables reporting.

# SENTRY_DSN_IAM=
# SENTRY_DSN_MEDIA=
# SENTRY_DSN_DATASET=
# SENTRY_DSN_SETTING=
# SENTRY_DSN_AUDIT=
# SENTRY_DSN_SYNC=
# SENTRY_DSN_NOTIFICATION=
