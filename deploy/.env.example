# Settings for this IDAH install, read by docker compose. After changing a
# value, apply it with: docker compose up -d
#
# install.sh creates this file from .env.example and generates every secret.

# --- Required -------------------------------------------------------------

# The release to run. Every service uses this tag; upgrade by changing it.
IDAH_VERSION=

# The public URL users open in a browser, scheme included, no trailing slash.
IDAH_URL=https://idah.example.com

# --- Secrets, generated by install.sh -------------------------------------

# PostgreSQL credentials. With the bundled database, changing them after the
# first start does not change the database: its volume keeps the credentials
# it was created with. Single-quoted, so every character is taken literally.
POSTGRES_USER=idah
POSTGRES_PASSWORD=''

# One password per internal service account.
IDAH_SERVICE_PASSWORD_IAM=
IDAH_SERVICE_PASSWORD_DATASET=
IDAH_SERVICE_PASSWORD_MEDIA=
IDAH_SERVICE_PASSWORD_SETTING=
IDAH_SERVICE_PASSWORD_NOTIFICATION=
IDAH_SERVICE_PASSWORD_SYNC=
IDAH_SERVICE_PASSWORD_AUDIT=

# --- Email ----------------------------------------------------------------
# Optional. Leave MAIL_SMTP_HOST empty to disable email notifications.
# MAIL_SMTP_USER may be empty for servers that need no authentication. The
# user and password are single-quoted, so every character is taken literally.

MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=''
MAIL_SMTP_PASSWORD=''

# --- Optional -------------------------------------------------------------

# The port nginx listens on. Put your own TLS terminator in front of it.
# IDAH_HTTP_PORT=8080

# info is the default. debug is noisy but useful when reporting a problem.
# LOG_LEVEL=info

# Returns error details in API responses. Keep off outside debugging.
# LOG_SHOW_ERROR_DETAILS=false

# Images built from source rather than the published ones, e.g. idah-.
# IDAH_IMAGE_PREFIX=

# --- Optional: your own PostgreSQL ----------------------------------------
# IDAH runs its own PostgreSQL unless these are set. POSTGRES_USER then needs
# the CREATEDB privilege, or the seven idah_* databases must already exist and
# be owned by it. The extensions IDAH creates (pg_trgm, pgcrypto, uuid-ossp)
# do not need a superuser.
#
# For a server on this machine use host.docker.internal: inside a container,
# localhost is the container itself.

# IDAH_POSTGRES_CONTAINER=0
# POSTGRES_HOST=db.example.com
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# --- Optional: S3 instead of local file storage ---------------------------
# Uploaded files go to the media_files and sync_files volumes by default.
# Setting an adapter to s3 makes all five of its settings required; a missing
# one stops that service at boot with the variable named.

# MEDIAS_FILES_ADAPTER=s3
# MEDIAS_FILES_BUCKET=
# MEDIAS_FILES_REGION=
# MEDIAS_FILES_ENDPOINT=
# MEDIAS_FILES_ACCESS_KEY_ID=
# MEDIAS_FILES_SECRET_ACCESS_KEY=

# SYNC_FILES_ADAPTER=s3
# SYNC_FILES_BUCKET=
# SYNC_FILES_REGION=
# SYNC_FILES_ENDPOINT=
# SYNC_FILES_ACCESS_KEY_ID=
# SYNC_FILES_SECRET_ACCESS_KEY=

# --- Optional: error reporting --------------------------------------------
# Your own Sentry project, if you use one. Empty disables reporting, which is
# the default: this install never reports to the vendor.

# The browser app. Nothing is built into the image, so this is the only way a
# DSN reaches it.
# SENTRY_DSN_FRONTEND=

# Labels events with the environment they came from.
# SENTRY_ENVIRONMENT=production

# Session replay records your users' screens. Off by default; turn it on only
# if your own Sentry project is an appropriate place for those recordings.
# SENTRY_REPLAY_SAMPLE_RATE=0
# SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0

# The backend services.
# SENTRY_DSN_IAM=
# SENTRY_DSN_MEDIA=
# SENTRY_DSN_DATASET=
# SENTRY_DSN_SETTING=
# SENTRY_DSN_AUDIT=
# SENTRY_DSN_SYNC=
# SENTRY_DSN_NOTIFICATION=
