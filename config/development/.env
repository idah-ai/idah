# Development settings shared by every Ruby service, loaded by
# compose.override.yml. Each service's config/development/<service>.env adds its
# database name, service account and anything specific to it.
# Committed on purpose: it holds dev-only defaults, no real secrets.

# Where the platform is reachable in development.
IDAH_URL=https://idah.localhost:8443
SERVICE_DOMAIN=idah.localhost

# Public key matching iam's signing key; iam overrides it with the private one.
SERVICE_JWT_KEY=file:./config/keys/public.dev.pem

# Every service signs in with its own account (set per service) and this password.
IDAH_SERVICE_PASSWORD=password

# Database configuration
# Defaults to the postgres container from compose.override.yml. To use the
# PostgreSQL on your machine, set IDAH_POSTGRES_HOST=host.docker.internal in a
# root .env file (see .env.example).
POSTGRES_HOST=${IDAH_POSTGRES_HOST:-postgres}
POSTGRES_PORT=5432

# The only place the development credentials are set: the services and the
# postgres container both read them from here. To match the PostgreSQL on your
# machine, set IDAH_POSTGRES_USER and IDAH_POSTGRES_PASSWORD in a root .env.
# The container applies them only when it creates its data volume.
POSTGRES_USER=${IDAH_POSTGRES_USER:-postgres}
POSTGRES_PASSWORD=${IDAH_POSTGRES_PASSWORD:-postgres}
POSTGRES_CREDENTIALS=${POSTGRES_USER}:${POSTGRES_PASSWORD}

# Redis configuration
# Defaults to the redis container from compose.override.yml. To use the Redis
# on your machine, set IDAH_REDIS_HOST=host.docker.internal in a root .env file.
REDIS_STREAM_URL=redis://${IDAH_REDIS_HOST:-redis}:6379/0

EAGER_LOAD=1

# Observability (shared defaults; DSN per service in .env.<service>)
# SENTRY_TRACES_SAMPLE_RATE=1.0    # trace 100% of transactions
# SENTRY_ENABLE_LOGS=true          # turn on Sentry Logs
# SENTRY_PROFILES_SAMPLE_RATE=1.0  # profile 10% of traced transactions