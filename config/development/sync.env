# Development settings for the sync service, loaded by compose.override.yml.
# Values shared by every service are in config/development/.env.

DATABASE_URI=postgres://${POSTGRES_CREDENTIALS}@${POSTGRES_HOST}:${POSTGRES_PORT}/idah_sync_development

IDAH_SERVICE_ACCOUNT=sync@services.idah.ai

# Synced files and exports are stored on disk in development
# (config.development.yml uses the file_system adapter), but config.yml is still
# read at boot and requires these, so they have to be defined even though they
# stay empty.
SYNC_FILES_BUCKET=
SYNC_FILES_ACCESS_KEY_ID=
SYNC_FILES_SECRET_ACCESS_KEY=
SYNC_FILES_REGION=
SYNC_FILES_ENDPOINT=
