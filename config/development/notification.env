# Development settings for the notification service, loaded by
# compose.override.yml. Values shared by every service are in
# config/development/.env.

DATABASE_URI=postgres://${POSTGRES_CREDENTIALS}@${POSTGRES_HOST}:${POSTGRES_PORT}/idah_notification_development

IDAH_SERVICE_ACCOUNT=notification@services.idah.ai

# MailHog: read the mail it catches at https://idah.localhost:8443/mails
MAIL_SMTP_HOST=mails
MAIL_SMTP_PORT=1025
