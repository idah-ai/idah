# Development settings for the media service, loaded by compose.override.yml.
# Values shared by every service are in config/development/.env.

DATABASE_URI=postgres://${POSTGRES_CREDENTIALS}@${POSTGRES_HOST}:${POSTGRES_PORT}/idah_media_development

IDAH_SERVICE_ACCOUNT=media@services.idah.ai

# Media files are stored on disk in development (config.development.yml uses the
# file_system adapter), but config.yml is still read at boot and requires these,
# so they have to be defined even though they stay empty.
MEDIAS_FILES_BUCKET=
MEDIAS_FILES_ACCESS_KEY_ID=
MEDIAS_FILES_SECRET_ACCESS_KEY=
MEDIAS_FILES_REGION=
MEDIAS_FILES_ENDPOINT=

# Disable threads for ffmpeg on development to use normal CPU
IDAH_VIDEO_DECODING_THREADS=
IDAH_VIDEO_ENCODING_THREADS=
