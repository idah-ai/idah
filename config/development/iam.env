# Development settings for the iam service, loaded by compose.override.yml.
# Values shared by every service are in config/development/.env.

# iam signs service tokens, so it needs the private key; the other services
# use the public key from .env.
SERVICE_JWT_KEY=file:./config/keys/private.dev.pem

DATABASE_URI=postgres://${POSTGRES_CREDENTIALS}@${POSTGRES_HOST}:${POSTGRES_PORT}/idah_iam_development

IDAH_SERVICE_ACCOUNT=iam@services.idah.ai
