# Values interpolated into compose.production.yaml (${...}) at build/deploy time.
# Copy to config/production/.env and fill in — loaded automatically by `bin/compose production`.
# NOTE: frontend VITE_* are compiled into the JS bundle at BUILD time, so they
# must be set here (Docker build args cannot be read from a service env_file).

# Public URL of the production deployment
IDAH_URL=http://localhost:8080
VITE_IDAH_HOST=http://localhost:8080

# Frontend Sentry DSN (baked into the bundle at build; empty disables it)
VITE_SENTRY_DSN=
